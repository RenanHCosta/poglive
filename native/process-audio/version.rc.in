#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @POGLIVE_VERSION_COMMA@,0
 PRODUCTVERSION @POGLIVE_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Renan Costa\0"
      VALUE "FileDescription", "Poglive process audio helper\0"
      VALUE "FileVersion", "@POGLIVE_VERSION@\0"
      VALUE "InternalName", "poglive-process-audio\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Renan Costa\0"
      VALUE "OriginalFilename", "poglive-process-audio.exe\0"
      VALUE "ProductName", "Poglive\0"
      VALUE "ProductVersion", "@POGLIVE_VERSION@.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
