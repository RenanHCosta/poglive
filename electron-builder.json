{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.poglive.desktop",
  "productName": "Poglive",
  "copyright": "Copyright © 2026 Renan Costa",
  "asar": true,
  "npmRebuild": false,
  "directories": { "output": "release" },
  "files": [
    "dist/main/**/*.cjs",
    "dist/preload/**/*.cjs",
    "dist/renderer/**/*",
    "!**/*.map",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "native/process-audio/build/bin/poglive-process-audio.exe",
      "to": "poglive-process-audio.exe"
    },
    {
      "from": "build/THIRD_PARTY_NOTICES.txt",
      "to": "THIRD_PARTY_NOTICES.txt"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "executableName": "Poglive",
    "requestedExecutionLevel": "asInvoker",
    "signtoolOptions": {
      "publisherName": "SignPath Foundation"
    },
    "signExecutable": false
  },
  "nsis": {
    "artifactName": "Poglive-${version}-win-${arch}-setup.${ext}",
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "Poglive-${version}-win-${arch}-portable.${ext}",
    "requestExecutionLevel": "user"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "RenanHCosta",
      "repo": "poglive",
      "releaseType": "release"
    }
  ]
}
